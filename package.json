{
  "name": "sheizen",
  "private": true,
  "version": "0.1.0",
  "description": "Sheizen Wellness — full-stack monorepo (frontend + backend + shared)",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
