# Copy to .env and fill in. All EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time (same model as the web app's VITE_* vars).

# Same Supabase project as the web client portal. The anon key is a public
# client key restricted by RLS — safe to ship in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NestJS backend base URL.
#
# Production is the VPS: https://nusi.sirahagents.com
# Do NOT use api.sirahdigital.in — its DNS currently resolves to a private
# 10.x address, so a phone cannot reach it.
#
# For local backend dev use your PC's LAN IP, e.g. http://192.168.1.20:3001.
# This is only a DEFAULT: it can be overridden at runtime in
# Settings -> Server connection, so a wrong URL never needs a rebuild.
EXPO_PUBLIC_API_BASE_URL=https://nusi.sirahagents.com

# Release manifest for the in-app update check, published by
# deploy/vps/release-apk.sh. Deliberately NOT derived from
# EXPO_PUBLIC_API_BASE_URL, which is user-overridable in Settings — pointing the
# update check at a dev tunnel would offer bogus updates.
EXPO_PUBLIC_UPDATE_MANIFEST_URL=https://nusi.sirahagents.com/download/latest.json
