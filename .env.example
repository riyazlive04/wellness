# Copy this file to .env.local and fill in values from YOUR OWN dev Supabase project.
# NEVER paste production keys here. NEVER commit .env.local.

VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-dev-anon-publishable-key

# Backend API base (Phase 1+). Leave empty until the NestJS backend is up.
VITE_API_BASE_URL=http://localhost:3000

# NOTE: GEMINI_API_KEY MUST NOT live in the frontend. It belongs on the backend only.
# It was previously here in production — treat that key as compromised and rotate it.
