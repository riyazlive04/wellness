# =============================================================================
# Frontend production env — paste these into Vercel → Project Settings →
# Environment Variables. NEVER commit real values; this file is the template
# that documents what's needed.
# =============================================================================

# Supabase — same project as production. The anon key is safe to expose
# (it's a public client key restricted by RLS); the service-role key is NOT
# and only lives on the backend.
VITE_SUPABASE_URL=https://YOUR-SUPABASE-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...the-anon-key...

# Where the frontend's api client sends requests. Set this to the Render
# backend URL (or your custom domain if you've added one).
VITE_API_BASE_URL=https://YOUR-BACKEND-SERVICE.onrender.com