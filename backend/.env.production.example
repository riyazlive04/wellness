# =============================================================================
# Backend production env — paste these into Render → Service → Environment.
# NEVER commit real values; this file is the template that documents what's
# needed. The `render.yaml` blueprint declares each key with `sync: false`
# so Render prompts you for the value at first deploy.
# =============================================================================

# Runtime
NODE_ENV=production
PORT=10000                                              # Render assigns; main.ts reads from env
# Frontend origin(s) for CORS. One URL, or a comma-separated list (no spaces
# needed) to allow several at once during a domain cutover. The FIRST entry is
# treated as the primary origin (used to build invite links).
# e.g. https://nusi-sirahdigital.vercel.app,https://wellness-frontend-lemon.vercel.app
FRONTEND_ORIGIN=https://nusi-sirahdigital.vercel.app

# Supabase Postgres — pooler URL for runtime queries, direct URL for Prisma
# migrations. Password must be URL-encoded (e.g. '@' → '%40').
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:URLENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:URLENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Supabase Auth
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=                                    # Settings → API → JWT Secret (raw, not base64)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                        # Settings → API → service_role key (sensitive!)

# Google Gemini — Voice AI + Plate Vision
GEMINI_API_KEY=AIza...                                  # Google AI Studio → API keys

# Google OAuth — marker vars only; real credentials live in Supabase Dashboard
# → Auth → Providers → Google. These exist so /admin/integrations can show
# the integration as "Connected."
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# Razorpay — payments + webhooks. Get from Razorpay Dashboard → Account &
# Settings → API Keys + Webhooks.
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...                             # Set when adding webhook → /api/v1/webhooks/razorpay

# Evolution API — WhatsApp messaging
EVOLUTION_API_URL=https://evolution.your-host.com
EVOLUTION_API_KEY=...
EVOLUTION_INSTANCE_NAME=sirah-main

# Resend — transactional email (magic-link sender, etc.)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@your-domain.com

# Sentry — error tracking. Leave unset until you sign up.
SENTRY_DSN=https://...@sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog — product analytics. Leave unset until you sign up.
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# Redis — shared response cache across instances (recommended in production).
# Empty = in-memory per-instance cache (still works). To enable the shared cache:
#   Upstash (free): https://console.upstash.com → Create Database → copy URL.
#   Render: New → Key Value → copy the Internal Redis URL.
# Set REDIS_URL in the Render backend service's Environment tab (not committed).
REDIS_URL=