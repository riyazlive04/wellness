# Copy to .env.local. Never commit .env.local.
# Get values from YOUR dev Supabase project's API + Database settings page.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4000

# --- Database (Prisma) -------------------------------------------------------
# Pooled connection for queries (port 6543, pgbouncer)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://YOUR_REF.supabase.co
# Get from: Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# Get from: Project Settings → API → service_role key
# BACKEND ONLY. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
# Rotated Gemini API key (the prod one was leaked and must NOT be reused)
GEMINI_API_KEY=

# --- Throttling / Redis (Phase 6+, leave empty until BullMQ added) -----------
REDIS_URL=
