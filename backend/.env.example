# Copy to .env.local. Never commit .env.local.
# Get values from YOUR dev Supabase project's API + Database settings page.

NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4000,http://localhost:8081

# --- Database (Prisma) -------------------------------------------------------
# Pooled connection for queries (port 6543, pgbouncer)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://YOUR_REF.supabase.co
# Get from: Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# Get from: Project Settings → API → service_role key
# BACKEND ONLY. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
# Rotated Gemini API key (the prod one was leaked and must NOT be reused)
GEMINI_API_KEY=

# Plate Vision model selection. Overridable so a degraded model can be swapped
# without a code change and redeploy.
#   GEMINI_VISION_MODEL           primary model (default gemini-2.5-flash)
#   GEMINI_VISION_FALLBACK_MODEL  tried when the primary returns 429/503 or
#                                 times out; set to empty to disable
#                                 (default gemini-2.5-flash-lite)
#   GEMINI_VISION_TIMEOUT_MS      per-request deadline (default 30000)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_TIMEOUT_MS=30000

# --- Web push (VAPID) --------------------------------------------------------
# Generate your own dev pair:  npx web-push generate-vapid-keys
# Leave empty to disable push locally — the backend logs "VAPID keys not set —
# push notifications disabled" at boot and no-ops every send. Note push can
# never work against `npm run dev` anyway: the frontend only registers the
# service worker when import.meta.env.PROD, and in dev it actively unregisters
# any leftover worker. Test push against a production build.
#
# Set BOTH or push stays off — the public key alone lets the browser subscribe
# while every send silently no-ops. Use a DEV pair here, never the prod one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Redis (shared response cache; optional) ---------------------------------
# Leave EMPTY for local dev — the app uses a fast in-memory cache automatically.
# Set this in production for a shared, restart-safe cache across instances.
# Get a free URL in ~60s:
#   Upstash → https://console.upstash.com → Create Database (Regional, near your
#   backend) → copy the "redis://" (or "rediss://") connection URL.
#   Render  → dashboard → New → Key Value → copy its Internal Redis URL.
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=

# --- Video meetings (optional) -----------------------------------------------
# Appointments use embedded Jitsi. Leave these EMPTY to use the free public
# meet.jit.si server. To switch to your own 8x8 Jitsi-as-a-Service (no sign-in
# prompt), set all three from jaas.8x8.vc → API keys:
#   JITSI_JAAS_APP_ID = the vpaas-magic-cookie-... AppID
#   JITSI_JAAS_KID     = "<AppID>/<KeyID>" (the full string shown next to the key)
#   JITSI_JAAS_PRIVATE_KEY = the downloaded private key PEM (paste in Render env only)
JITSI_JAAS_APP_ID=
JITSI_JAAS_KID=
JITSI_JAAS_PRIVATE_KEY=

# Preferred provider: Daily.co (reliable, own subdomain, 10k free min/month).
# Set DAILY_API_KEY (dashboard.daily.co → Developers → API keys) and the app
# uses Daily for video automatically; leave empty to fall back to Jitsi above.
# The key is a SECRET — paste it in Render env / .env.local only, never in source.
DAILY_API_KEY=

# --- Transactional email (optional) ------------------------------------------
# Powers team-invite emails (and future notifications) via Resend. Leave empty
# to disable email — invites still work, the owner just shares the link manually.
# RESEND_FROM_EMAIL must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
