# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# ...but the OTA code-signing CERTIFICATE is public and MUST be shipped to EAS
# (app.json updates.codeSigningCertificate). Without this, prebuild fails.
!certs/certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Release signing secrets - never commit
credentials/

# expo-updates code signing — the PRIVATE key proves an update is authentic.
# Never commit it. Back it up like the release keystore, or you can never
# publish another OTA update. The certificate (certs/) is public.
/keys/

# OTA: local export staging + test bundles (regenerated by publish-ota.sh)
/dist-ota/
/.ota-stage/
/ota-server/updates/
.export-check/

# Release binaries. Three .aab files were committed earlier and already account
# for most of the ~280 MB .git directory; each new one adds ~90 MB forever,
# since git history is immutable. Build artefacts are reproducible from a tag —
# keep them in store-assets/ locally and upload to Play from there.
*.aab
*.apk
store-assets/apk-archive/
