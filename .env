# NestJS backend base URL — PRODUCTION VPS (always on, works on any network).
# Verified: /api/v1/health -> {"status":"ok","db":"up"} and /me/* -> 401 (auth enforced).
# No tunnel and no dev PC required.
EXPO_PUBLIC_API_BASE_URL=https://nusi.sirahagents.com
# NOTE: api.sirahdigital.in currently resolves to a private IP (10.x) — its DNS
# is not pointed at the VPS, so do NOT use it until that's fixed.
# Local dev alt (same Wi-Fi only): http://10.108.141.39:3001

# Password reset deep link (must also be allowlisted in Supabase Dashboard →
# Authentication → URL Configuration → Redirect URLs):
#   sirahlife://reset-password

# Release manifest for the in-app update check (published by
# deploy/vps/release-apk.sh). Deliberately NOT derived from
# EXPO_PUBLIC_API_BASE_URL, which is user-overridable in Settings — pointing the
# update check at a dev tunnel would offer bogus updates.
EXPO_PUBLIC_UPDATE_MANIFEST_URL=https://nusi.sirahagents.com/download/latest.json
